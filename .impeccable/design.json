  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent action with keyboard focus, hover, and pressed feedback.",
      "html": "<button class=\"ds-primary\" type=\"button\">Start training<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 16px;border-radius:9px;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:14px;font-weight:650;line-height:1.3;text-align:center;white-space:normal;cursor:pointer;transition:.15s;background:var(--accent,#234c3b);color:var(--on-accent,#fff);border:1px solid var(--accent,#234c3b);}.ds-primary:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(hover:hover){.ds-primary:hover:not(:disabled){background:color-mix(in srgb,var(--accent,#234c3b) 89%,var(--ink,#1b2b22));}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A bordered action that supports the primary task.",
      "html": "<button class=\"ds-ghost\" type=\"button\">Edit session</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 16px;border-radius:9px;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:14px;font-weight:650;line-height:1.3;text-align:center;white-space:normal;cursor:pointer;transition:.15s;background:var(--surface,#fff);color:var(--ink,#1b2b22);border:1px solid var(--border-2,#b8c7b8);}.ds-ghost:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-ghost:active{transform:translateY(1px)}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}@media(hover:hover){.ds-ghost:hover:not(:disabled){background:var(--surface-2,#f5f7f3);border-color:var(--border-2,#b8c7b8);}}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Destructive action",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Critical text and a soft fill preserve the meaning of a destructive action.",
      "html": "<button class=\"ds-danger\" type=\"button\">Delete session</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 16px;border-radius:9px;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:14px;font-weight:650;line-height:1.3;text-align:center;white-space:normal;cursor:pointer;transition:.15s;background:var(--crit-soft,#fbe6e4);color:var(--crit,#b43636);border:1px solid transparent;}.ds-danger:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-danger:active{transform:translateY(1px)}.ds-danger:disabled{opacity:.5;cursor:not-allowed}@media(hover:hover){.ds-danger:hover:not(:disabled){background:var(--surface-2,#f5f7f3);border-color:var(--border-2,#b8c7b8);}}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "General form field with sentence-case label, readable input, and visible focus.",
      "html": "<div class=\"ds-field\"><label for=\"ds-session-name\">Session name</label><input id=\"ds-session-name\" type=\"text\" placeholder=\"Name your session\" autocomplete=\"off\"></div>",
      "css": ".ds-field{width:min(100%,320px);font-family:var(--body,\"Public Sans\",system-ui,sans-serif)}.ds-field label{display:block;margin-bottom:8px;color:var(--ink-2,#3f5146);font-size:12px;font-weight:650}.ds-field input{width:100%;max-width:294px;min-height:44px;padding:12px;border:1px solid var(--border-2,#b8c7b8);border-radius:8px;background:var(--surface-2,#f5f7f3);color:var(--ink,#1b2b22);font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:16px;transition:.15s}.ds-field input::placeholder{color:var(--muted,#5b6b60);opacity:1}.ds-field input:focus{outline:2px solid var(--accent,#234c3b);outline-offset:2px;border-color:var(--accent,#234c3b);box-shadow:none}.ds-field input:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
    },
    {
      "name": "Trainer navigation",
      "kind": "nav",
      "refersTo": "trainer-navigation-selected",
      "description": "The four trainers share one evergreen rail and pale leaf selected item.",
      "html": "<div class=\"ds-trainer-nav\" role=\"tablist\" aria-label=\"Choose a trainer\"><button class=\"ds-trainer-tab\" type=\"button\" role=\"tab\" aria-selected=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 9v6m3-9v12m12-12v12m3-9v6M6 12h12\"/></svg><span>Muscle<small>Build muscle</small></span></button><button class=\"ds-trainer-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 17 10 11l4 3 6-9M14 5h6v6M4 21h16\"/></svg><span>Strength<small>Move more weight</small></span></button><button class=\"ds-trainer-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 3v18M17 3v18M7 6h10M7 12h10M7 18h10\"/></svg><span>Ladder<small>Earn your next skill</small></span></button><button class=\"ds-trainer-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4v6a7 7 0 0 0 7 7m7-13v6a7 7 0 0 1-7 7v4M9 7l3-3 3 3M12 4v13\"/></svg><span>Together<small>Balance your week</small></span></button></div>",
      "css": ".ds-trainer-nav{display:flex;flex-direction:column;gap:8px;padding:18px;width:180px;background:var(--shell-green,#234c3b)}.ds-trainer-tab{display:flex;align-items:center;gap:12px;min-height:64px;padding:11px 14px;border:0;border-radius:8px;background:transparent;color:#d4e0d8;text-align:left;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:14px;font-weight:600;cursor:pointer;transition:background .15s,color .15s}.ds-trainer-tab svg{flex:none}.ds-trainer-tab small{display:block;margin-top:3px;font-size:11px;font-weight:400;line-height:1.5;color:#bdcfc0}.ds-trainer-tab[aria-selected=\"true\"]{background:var(--shell-lime,#d4e6b5);color:#20392d}.ds-trainer-tab[aria-selected=\"true\"] small{color:#49603c}.ds-trainer-tab:hover:not([aria-selected=\"true\"]){background:#315d48;color:#fff}.ds-trainer-tab:focus-visible{outline:3px solid var(--shell-lime,#d4e6b5);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-trainer-tab{transition:none}}"
    },
    {
      "name": "Route navigation",
      "kind": "nav",
      "refersTo": "route-navigation-selected",
      "description": "Compact mobile route cells use a soft selected fill; desktop uses an underline.",
      "html": "<nav class=\"ds-routes\" aria-label=\"Trainer pages\"><button class=\"ds-route\" type=\"button\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10 12 3l9 7M5 9v12h14V9M9 21v-7h6v7\"/></svg>Today</button><button class=\"ds-route\" type=\"button\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 9v6m3-9v12m12-12v12m3-9v6M6 12h12\"/></svg>Train</button><button class=\"ds-route\" type=\"button\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 5h14v16H5zM8 3v4m8-4v4M8 11h8m-8 5h5\"/></svg>Plan</button><button class=\"ds-route\" type=\"button\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V4m0 16h16M7 15l4-5 4 3 5-7\"/></svg>Progress</button><button class=\"ds-route\" type=\"button\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4h6v16H4zM14 4h6v16h-6z\"/></svg>Library</button></nav>",
      "css": ".ds-routes{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:3px;width:min(100%,440px);padding:8px;background:var(--surface,#fff);border-top:1px solid var(--border,#dce3d8)}.ds-route{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:48px;min-width:0;padding:7px 2px;border:0;border-radius:9px;background:transparent;color:var(--muted,#5b6b60);font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:10px;font-weight:650;cursor:pointer}.ds-route[aria-current]{color:var(--accent-ink,#234c3b);background:var(--accent-soft,#e1ebd9)}.ds-route:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-route:active{transform:translateY(1px)}@media(hover:hover){.ds-route:hover:not([aria-current]){background:var(--surface-2,#f5f7f3);color:var(--ink,#1b2b22)}}@media(min-width:1000px){.ds-routes{display:flex;gap:25px;padding:0;background:var(--bg,#f1f4ef);border-top:0;border-bottom:1px solid var(--border-2,#b8c7b8)}.ds-route{position:relative;flex-direction:row;gap:8px;min-height:47px;padding:12px 0 13px;font-size:13px;font-weight:600;border-radius:0}.ds-route svg{width:16px;height:16px}.ds-route[aria-current]{background:transparent;font-weight:700}.ds-route[aria-current]::after{content:\"\";position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--accent,#234c3b)}.ds-route:hover:not([aria-current]){background:transparent}}"
    },
    {
      "name": "Information chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "A quiet label for exercise metadata; it is not an action.",
      "html": "<span class=\"ds-chip\">Bodyweight</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:5px;max-width:100%;padding:4px 7px;border:1px solid var(--border,#dce3d8);border-radius:6px;background:var(--surface-2,#f5f7f3);color:var(--ink-2,#3f5146);font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:11px;font-weight:600;line-height:1.25;white-space:normal}"
    },
    {
      "name": "Next session",
      "kind": "card",
      "refersTo": "next-session",
      "description": "The next action gets a calm field-green surface and a clear type hierarchy.",
      "html": "<section class=\"ds-next\"><div class=\"ds-eyebrow\">Your next session</div><h2>Ready when you are.</h2><p>Choose your training and record each set as you go.</p><button class=\"ds-next-action\" type=\"button\">Start training<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></section>",
      "css": ".ds-next{max-width:440px;padding:24px;border-radius:16px;background:var(--hero,#e6eedf);color:var(--ink,#1b2b22);font-family:var(--body,\"Public Sans\",system-ui,sans-serif)}.ds-eyebrow{margin-bottom:9px;font-size:12px;font-weight:600;line-height:1.5;color:var(--muted,#5b6b60)}.ds-next h2{max-width:24ch;margin:0 0 12px;font-family:var(--disp,\"Archivo\",\"Public Sans\",sans-serif);font-size:28px;font-weight:750;line-height:1.13;letter-spacing:-.035em;text-wrap:balance}.ds-next p{max-width:58ch;margin:0 0 23px;font-size:14px;line-height:1.6;color:var(--ink-2,#3f5146)}.ds-next-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 16px;border-radius:9px;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:14px;font-weight:650;line-height:1.3;text-align:center;white-space:normal;cursor:pointer;transition:.15s;background:var(--accent,#234c3b);color:var(--on-accent,#fff);border:1px solid var(--accent,#234c3b);}.ds-next-action:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-next-action:active{transform:translateY(1px)}.ds-next-action:disabled{opacity:.5;cursor:not-allowed}@media(hover:hover){.ds-next-action:hover:not(:disabled){background:color-mix(in srgb,var(--accent,#234c3b) 89%,var(--ink,#1b2b22));}}@media(prefers-reduced-motion:reduce){.ds-next-action{transition:none}}.ds-next-action{min-height:48px}@media(min-width:1000px){.ds-next{padding:28px}.ds-next h2{font-size:32px}}"
    },
    {
      "name": "Training week",
      "kind": "custom",
      "refersTo": "training-week",
      "description": "Seven equal day tiles separate recorded completion from the current date.",
      "html": "<section class=\"ds-week\" aria-label=\"Example training week\"><h3>Training this week <small>Example</small></h3><div class=\"ds-days\"><div class=\"ds-day ds-trained\"><span class=\"ds-day-name\">Mon</span><span class=\"ds-date\">12</span><span class=\"ds-day-mark\" aria-label=\"Completed\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></div><div class=\"ds-day\"><span class=\"ds-day-name\">Tue</span><span class=\"ds-date\">13</span><span class=\"ds-day-mark\" aria-label=\"No recorded session\">—</span></div><div class=\"ds-day ds-trained ds-today\" aria-label=\"Today, completed\"><span class=\"ds-day-name\">Wed</span><span class=\"ds-date\">14</span><span class=\"ds-day-mark\" aria-label=\"Completed\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></div><div class=\"ds-day\"><span class=\"ds-day-name\">Thu</span><span class=\"ds-date\">15</span><span class=\"ds-day-mark\" aria-label=\"No recorded session\">—</span></div><div class=\"ds-day\"><span class=\"ds-day-name\">Fri</span><span class=\"ds-date\">16</span><span class=\"ds-day-mark\" aria-label=\"No recorded session\">—</span></div><div class=\"ds-day\"><span class=\"ds-day-name\">Sat</span><span class=\"ds-date\">17</span><span class=\"ds-day-mark\" aria-label=\"No recorded session\">—</span></div><div class=\"ds-day\"><span class=\"ds-day-name\">Sun</span><span class=\"ds-date\">18</span><span class=\"ds-day-mark\" aria-label=\"No recorded session\">—</span></div></div><p class=\"ds-week-note\">Illustrative preview. The app displays only your saved sessions.</p></section>",
      "css": ".ds-week{max-width:640px;padding:22px;border:1px solid var(--border,#dce3d8);border-radius:14px;background:var(--surface,#fff);color:var(--ink,#1b2b22);font-family:var(--body,\"Public Sans\",system-ui,sans-serif)}.ds-week h3{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 18px;font-family:var(--disp,\"Archivo\",\"Public Sans\",sans-serif);font-size:17px;font-weight:700;letter-spacing:-.02em}.ds-week h3 small{font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:11px;font-weight:400;color:var(--muted,#5b6b60)}.ds-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.ds-day{display:flex;flex-direction:column;align-items:center;gap:7px;min-width:0;padding:12px 3px;border-radius:9px;background:var(--surface-2,#f5f7f3)}.ds-day-name{font-size:10px;font-weight:600;color:var(--muted,#5b6b60)}.ds-date{font-size:19px;font-weight:650;line-height:1.2;letter-spacing:-.03em;font-variant-numeric:tabular-nums}.ds-day-mark{display:grid;place-items:center;width:16px;height:16px;font-size:13px;color:var(--faint,#617165)}.ds-day-mark svg{width:14px;height:14px}.ds-trained{background:var(--accent,#234c3b);color:var(--on-accent,#fff)}.ds-trained .ds-day-name,.ds-trained .ds-day-mark{color:var(--on-accent,#fff)}.ds-today{outline:1px solid var(--border-2,#b8c7b8);outline-offset:-1px}.ds-week-note{margin:15px 0 0;font-size:12px;line-height:1.5;color:var(--muted,#5b6b60)}@media(max-width:389px){.ds-week{padding:17px}.ds-days{gap:4px}.ds-day{padding:10px 2px}.ds-date{font-size:18px}.ds-day-name{font-size:9px}}"
    },
    {
      "name": "Set entry",
      "kind": "custom",
      "refersTo": "set-input",
      "description": "Compact editable numbers keep the next row visible and completion within reach.",
      "html": "<div class=\"ds-set-preview\"><div class=\"ds-set-head\" aria-hidden=\"true\"><span>Set</span><span>kg</span><span>Reps</span><span>RIR</span><span>Done</span><span></span></div><div class=\"ds-set-row\"><span class=\"ds-set-index\">1</span><input class=\"ds-set-input\" aria-label=\"Set 1 weight in kilograms\" inputmode=\"decimal\" placeholder=\"0\"><input class=\"ds-set-input\" aria-label=\"Set 1 repetitions\" inputmode=\"numeric\" placeholder=\"8\"><input class=\"ds-set-input ds-set-rir\" aria-label=\"Set 1 repetitions in reserve\" inputmode=\"numeric\" placeholder=\"2\"><button class=\"ds-set-done\" type=\"button\" aria-label=\"Complete set 1\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></button><button class=\"ds-set-menu\" type=\"button\" aria-label=\"Set 1 options\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"5\" r=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"1.5\"/><circle cx=\"12\" cy=\"19\" r=\"1.5\"/></svg></button></div></div>",
      "css": ".ds-set-preview{max-width:520px;font-family:var(--body,\"Public Sans\",system-ui,sans-serif);color:var(--ink,#1b2b22)}.ds-set-head,.ds-set-row{display:grid;grid-template-columns:24px minmax(0,1.15fr) minmax(0,.95fr) 38px 42px 26px;align-items:center;gap:5px}.ds-set-head{padding:4px 4px 9px;font-size:10px;font-weight:600;letter-spacing:.025em;text-align:center;color:var(--muted,#5b6b60)}.ds-set-row{padding:5px 3px;border-radius:8px;background:var(--accent-soft,#e1ebd9);transition:background .25s}.ds-set-index{display:grid;place-items:center;width:24px;height:24px;border-radius:5px;background:var(--accent,#234c3b);color:var(--on-accent,#fff);font-size:11px;font-weight:800}.ds-set-input{width:100%;min-width:0;height:44px;padding:0;border:1px solid var(--border,#dce3d8);border-radius:7px;background:var(--surface-2,#f5f7f3);color:var(--ink,#1b2b22);font-family:var(--body,\"Public Sans\",system-ui,sans-serif);font-size:16px;font-weight:650;text-align:center;font-variant-numeric:tabular-nums;transition:.15s}.ds-set-input::placeholder{color:var(--muted,#5b6b60);font-weight:400}.ds-set-rir{font-size:13px;font-weight:600;color:var(--ink-2,#3f5146)}.ds-set-input:focus{outline:2px solid var(--accent,#234c3b);outline-offset:2px;border-color:var(--accent,#234c3b)}.ds-set-done{display:grid;place-items:center;width:100%;height:44px;padding:0;border:1px solid var(--border,#dce3d8);border-radius:7px;background:var(--surface,#fff);color:var(--muted,#5b6b60);cursor:pointer;transition:.15s}.ds-set-menu{display:grid;place-items:center;width:26px;height:36px;padding:0;border:0;background:transparent;color:var(--muted,#5b6b60);cursor:pointer}.ds-set-done:focus-visible,.ds-set-menu:focus-visible{outline:3px solid var(--accent,#234c3b);outline-offset:3px;}.ds-set-done:active{transform:scale(.9)}@media(hover:hover){.ds-set-done:hover{border-color:var(--accent,#234c3b);color:var(--accent,#234c3b)}}@media(max-width:389px){.ds-set-head,.ds-set-row{grid-template-columns:22px minmax(0,1fr) minmax(0,.9fr) 32px 38px 24px;gap:4px}.ds-set-input{font-size:15px}.ds-set-head{font-size:9px;letter-spacing:0}}@media(prefers-reduced-motion:reduce){.ds-set-row,.ds-set-input,.ds-set-done{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Evergreen Training Field Guide",
    "overview": "Milo feels grounded, readable, and ready for use between sets. Evergreen wayfinding frames a mineral green workspace; white surfaces and pale leaf selections make the current task clear. The visual identity comes from useful structure, confident headings, and consistently treated controls.\n\nMuscle, Strength, Ladder, and Together share one visual language. Training numbers receive space and stable alignment; explanatory copy remains close to the decision it supports. The system carries through light, dark, and system themes without changing the meaning of a control or status.",
    "keyCharacteristics": [
      "Evergreen wayfinding with pale leaf selection.",
      "Archivo headings paired with locally served Public Sans.",
      "Flat, bordered working surfaces with compact, readable density.",
      "Consistent navigation and controls across all four trainers.",
      "Visible focus, responsive layouts, and restrained state changes."
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "Use accent for action, selection, and recorded progress. It must not become ornamental striping or a separate identity for each trainer.",
        "section": "colors"
      },
      {
        "name": "The Stable Number Rule",
        "body": "Let values change without changing their alignment. Preserve tabular numerals and clear units instead of introducing a decorative monospaced face.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Reserve elevation for transient shell overlays. Do not add shadows to ordinary training cards or accent buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** share the shell, semantic colors, type pairing, and control patterns across all four trainers.",
      "**Do** make the next training action visually clear while keeping evidence and explanation readable.",
      "**Do** preserve light, dark, and system themes, visible keyboard focus, and reduced-motion behavior.",
      "**Do** use tabular numerals, explicit units, and wrapping exercise names in compact working layouts.",
      "**Do** show real training history and honest empty states.",
      "**Do** keep phone logging controls reachable and clear of fixed navigation and timers."
    ],
    "donts": [
      "**Don't** restore separate trainer palettes, decorative gradients, backdrop blur, or glowing cards.",
      "**Don't** use color alone to communicate completion, warnings, selection, or destructive intent.",
      "**Don't** shrink editable values or hide necessary set actions to force a narrow row.",
      "**Don't** add decorative motion or animate route entry.",
      "**Don't** manufacture achievements or completed days to fill an empty screen.",
      "**Don't** introduce remote font dependencies or framework-only component previews."
    ]
  }
}
